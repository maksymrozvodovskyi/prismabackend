generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum ProjectStatus {
  PLANNED
  INPROGRESS
  ONHOLD
  COMPLETED
  SUPPORT
  CANCELLED
}

enum ActivityType {
  CODING
  REVIEW
  STUDING
  SICKLEAVE
  VACATION
}

enum UserStatus {
  RED
  YELLOW
  GREEN
  CLEAN
  ARCHIVED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role
  status    UserStatus @default(GREEN)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  projects          Project[]
  workLogs          WorkLog[]
  passwordResetCodes PasswordResetCode[]
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users     User[]
  workLogs  WorkLog[]
}

model WorkLog {
  id         String       @id @default(cuid())
  userId     String
  projectId  String
  date       DateTime     @db.Date
  hours      Float
  activity   ActivityType
  isApproved Boolean?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user      User         @relation(fields: [userId], references: [id])
  project   Project      @relation(fields: [projectId], references: [id])

  @@index([userId])
  @@index([projectId])
}

model PasswordResetCode {
  id        String   @id @default(cuid())
  userId    String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
  @@index([expiresAt])
}

model TokenBlacklist {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}